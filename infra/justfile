default:
    @just --list


# ==========================================================================================
# terraform: 差分の確認と適用 (apply と destroy はユーザーだけが実行する)
# ==========================================================================================
# 初期化する (backend は envs/<env>/backend.tf の S3)
init env="prd":
    terraform -chdir=envs/{{ env }} init

# 差分を確認する
plan env="prd": (init env)
    terraform -chdir=envs/{{ env }} plan

# 差分を AWS に適用する (環境名は省略できない)
apply env:
    terraform -chdir=envs/{{ env }} apply

# 指定したモジュールのリソースだけを削除する (例: just infra::destroy-target prd module.network)
destroy-target env target:
    terraform -chdir=envs/{{ env }} destroy -target={{ target }}


# ==========================================================================================
# 静的検査
# ==========================================================================================
# 整形する
fmt:
    terraform fmt -recursive

# 整形漏れを検査する
fmt-check:
    terraform fmt -recursive -check -diff

# 構文と型を検査する
validate env="prd": (init env)
    terraform -chdir=envs/{{ env }} validate

# tflint のプラグインを取得する
lint-init:
    tflint --init --config {{ source_directory() }}/.tflint.hcl

# tflint で検査する
lint: lint-init
    tflint --recursive --config {{ source_directory() }}/.tflint.hcl

# trivy で設定の脆弱性を検査する (その環境の tfvars だけを渡す)
scan env="prd":
    trivy config --config trivy.yaml --tf-vars envs/{{ env }}/terraform.tfvars envs/{{ env }}

# PR を出す前の静的検査をまとめて実行する
check env="prd": fmt-check lint (validate env) (scan env)


# ==========================================================================================
# terraform: provider の依存ロック
# ==========================================================================================
# 手元 (darwin_arm64) と CI (linux_amd64) の両方のチェックサムを lock に載せる
# init は実行したマシンの分しか記録せず、そのままだと CI の init で lock が書き換わるため
# lock を初めて作ったときと、provider のバージョンを上げたときに実行する
[doc("手元と CI の両方のチェックサムを lock に追記する")]
lock env="prd":
    terraform -chdir=envs/{{ env }} providers lock -platform=linux_amd64 -platform=darwin_arm64


# ==========================================================================================
# テスト用リスナー (8443 番) の接続元
# ==========================================================================================
# 今のグローバル IP を、テスト用リスナーへの接続を許可するプレフィックスリストに反映する
#   - リストは Terraform の外で管理する (公開リポジトリに IP を書かないため。destroy しても残る)
#   - リストがなければ作り、あれば label の IP を今のものに置き換える (同じ IP なら何もしない)
#   - IP が変わったときに実行する。セキュリティグループはリストを参照しているため、apply は要らない
[doc("今のグローバル IP を 8443 番の許可リストに反映する")]
allow-my-ip env="prd" label="home":
    #!/usr/bin/env bash
    set -euo pipefail
    name="{{ env }}-amber-test-listener-allowed"
    cidr="$(curl -fsS https://checkip.amazonaws.com | tr -d '[:space:]')/32"

    id=$(aws ec2 describe-managed-prefix-lists --filters "Name=prefix-list-name,Values=${name}" \
        --query 'PrefixLists[0].PrefixListId' --output text)

    if [ "${id}" = "None" ]; then
        aws ec2 create-managed-prefix-list --prefix-list-name "${name}" \
            --address-family IPv4 --max-entries 3 \
            --entries "Cidr=${cidr},Description={{ label }}" \
            --tag-specifications "ResourceType=prefix-list,Tags=[{Key=project,Value=amber},{Key=environment,Value={{ env }}},{Key=managed_by,Value=cli}]" \
            --query 'PrefixList.PrefixListId' --output text
        echo "created ${name} with ${cidr} ({{ label }})"
        exit 0
    fi

    current=$(aws ec2 get-managed-prefix-list-entries --prefix-list-id "${id}" \
        --query "Entries[?Description=='{{ label }}'].Cidr | [0]" --output text)
    if [ "${current}" = "${cidr}" ]; then
        echo "${name} already allows ${cidr} ({{ label }})"
        exit 0
    fi

    version=$(aws ec2 describe-managed-prefix-lists --prefix-list-ids "${id}" \
        --query 'PrefixLists[0].Version' --output text)
    remove=()
    if [ "${current}" != "None" ]; then
        remove=(--remove-entries "Cidr=${current}")
    fi
    aws ec2 modify-managed-prefix-list --prefix-list-id "${id}" --current-version "${version}" \
        --add-entries "Cidr=${cidr},Description={{ label }}" ${remove[@]+"${remove[@]}"} \
        --query 'PrefixList.State' --output text
    echo "updated ${name}: ${current} -> ${cidr} ({{ label }})"
