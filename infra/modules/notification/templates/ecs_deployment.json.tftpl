{
  "channel": "${channel}",
  "text": "${title}: ${service}",
  "attachments": [
    {
      "color": "${color}",
      "blocks": [
        {
          "type": "header",
          "text": {
            "type": "plain_text",
            "text": "${title}",
            "emoji": true
          }
        },
        {
          "type": "section",
          "fields": [
            {
              "type": "mrkdwn",
              "text": "*Service*\n${service}"
            },
            {
              "type": "mrkdwn",
              "text": "*Deployment ID*\n<deploymentId>"
            }
          ]
        },
        {
          "type": "section",
          "text": {
            "type": "mrkdwn",
            "text": "*Reason*\n<reason>"
          }
        },
        {
          "type": "context",
          "elements": [
            {
              "type": "mrkdwn",
              "text": "<time> (UTC)"
            }
          ]
        }
      ]
    }
  ]
}
