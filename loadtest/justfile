# k6 は手元に入れず、版を固定したコンテナで動かす (Docker は backend のビルドでも使う)
# DOC: https://hub.docker.com/r/grafana/k6
k6_image := "grafana/k6:2.4.0"

# 送り先 (run の target で選ぶ)
#   - local: 手元のコンテナ (just backend::run)。コンテナの中の k6 から、手元の 8080 番に送る
#   - prd: ALB の前の Route 53 のレコード
local_url := "http://host.docker.internal:8080"
prd_url := "https://ecs-lab.tamaco-blog.jp"

default:
    @just --list


# ==========================================================================================
# 負荷試験 (送り先が動いている間だけ実行する。prd は enable_runtime = true の間だけ動く)
# ==========================================================================================
# デプロイ中に一定の RPS で送り、失敗の種類と新旧の版ごとの件数を出す (例: just loadtest::run 20 10m prd)
#   - 1 件でも失敗すれば、k6 は 0 以外のコード (閾値の超過は 99) で終わる
#   - 流し始めた時点の版を古い版 (old) とし、それと違う版を新しい版 (new) として数える
#   - target は送り先の名前 (local か prd)。既定は local で、prd に送るときだけ prd を付ける
#   - local と prd 以外の名前は、k6 を動かす前に error() で止める
#   - 値はコンテナの環境変数 (docker run -e) ではなく、k6 の -e で渡す (inspect とそろえる)
# DOC: https://just.systems/man/en/conditional-expressions.html
# DOC: https://just.systems/man/en/functions.html
[doc("一定の RPS で送り、失敗の種類と新旧の版ごとの件数を出す (1 件でも失敗すれば 99 で終わる)")]
run rate="10" duration="5m" target="local":
    docker run --rm -i \
        -v "{{ source_directory() }}/scripts:/scripts:ro" \
        {{ k6_image }} run \
        -e BASE_URL={{ if target == "local" { local_url } else if target == "prd" { prd_url } else { error("target は local か prd を渡す: " + target) } }} \
        -e RATE={{ rate }} \
        -e DURATION={{ duration }} \
        /scripts/availability.js


# ==========================================================================================
# 静的検査
# ==========================================================================================
# スクリプトを読み込み、組み立てた設定 (シナリオと閾値) を表示する。リクエストは送らない
#   - 値は run と同じく k6 の -e で渡す (k6 inspect は、コンテナの環境変数を読まない)
# DOC: https://grafana.com/docs/k6/latest/using-k6/environment-variables/
inspect rate="10" duration="5m":
    docker run --rm -i \
        -v "{{ source_directory() }}/scripts:/scripts:ro" \
        {{ k6_image }} inspect --execution-requirements \
        -e RATE={{ rate }} \
        -e DURATION={{ duration }} \
        /scripts/availability.js
